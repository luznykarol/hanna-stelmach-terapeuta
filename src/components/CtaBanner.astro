---
import { getContent } from '../lib/content';
import BookingButton from './BookingButton.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import ParallaxFerns from './ParallaxFerns.astro';
const { ctaBanner, editable } = await getContent();
---

<section class="relative overflow-x-clip bg-white text-forest-deep" {...editable.ctaBanner}>
  <ParallaxFerns variant="cta" />
  <Container class="relative z-10 flex flex-col items-center gap-7 py-16 text-center md:py-20">
    <Heading as="h2">{ctaBanner.heading}</Heading>
    <BookingButton variant="dark" />
  </Container>
</section>
