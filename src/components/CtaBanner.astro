---
import { getContent } from '../lib/content';
import BookingButton from './BookingButton.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
const { ctaBanner, editable } = await getContent();
---

<section class="relative overflow-hidden bg-white text-forest-deep" {...editable.ctaBanner}>
  <Container class="flex flex-col items-center gap-7 py-16 text-center md:py-20">
    <Heading as="h2">{ctaBanner.heading}</Heading>
    <BookingButton variant="dark" />
  </Container>
</section>
