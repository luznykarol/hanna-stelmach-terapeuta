---
import { getContent } from '../lib/content';
import Section from './Section.astro';
import SectionIntro from './SectionIntro.astro';
import RichText from './RichText.astro';
import { storyblokImage, storyblokSrcSet, storyblokSize } from '../lib/images';
const { therapy, editable } = await getContent();
---

<Section id={therapy.id} class="bg-forest text-white" {...editable.therapy}>
  <SectionIntro heading={therapy.heading} html={therapy.intro} textClass="text-white/80" />

    <ul class="grid gap-6 grid-cols-1 md:grid-cols-2 mt-6 lg:mt-0">
      {
        therapy.items.map((item, i) => (
          <li
            class="group flex flex-col items-center text-center gap-6"
            {...(editable.therapyItems[i] ?? {})}
          >
            <div class="relative">
              <div class="absolute left-1/2 size-[175px] -translate-x-1/2 -bottom-[24px] rounded-full bg-white shadow-sm -z-1"></div>
              
            
              {item.image ? (
                <img
                  src={storyblokImage(item.image, storyblokSize(item.image)?.width ?? 350)}
                  srcset={
                    storyblokSize(item.image)
                      ? `${storyblokImage(item.image, storyblokSize(item.image)!.width)} 1x, ${storyblokImage(item.image, storyblokSize(item.image)!.width * 2)} 2x`
                      : undefined
                  }
                  alt={item.imageAlt}
                  width={storyblokSize(item.image)?.width}
                  height={storyblokSize(item.image)?.height}
                  class=" object-cover"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div
                  class="flex h-full w-full items-center justify-center text-xs text-forest-deep/60"
                  aria-hidden="true"
                >
                </div>
              )}
              </div>
            <div class="mt-4 px-2">
              <h3 class="mb-2 text-[36px]">{item.name}</h3>
              <RichText html={item.description} class="text-white/75 max-w-prose" />
            </div>
          </li>
        ))
      }
    </ul>
</Section>
