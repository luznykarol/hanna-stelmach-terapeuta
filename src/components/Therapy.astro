---
import { getContent } from '../lib/content';
import Container from './Container.astro';
import Heading from './Heading.astro';
import Paragraph from './Paragraph.astro';
import leafMask from '../assets/svg/leaf_mask.svg?url';
const { therapy, editable } = await getContent();
---

<section id={therapy.id} class="bg-forest text-white" {...editable.therapy}>
  <Container class="relative z-10 py-20 md:py-28">
     <div class="mx-auto w-full  grid items-center gap-10 md:grid-cols-2 md:gap-14 md:pb-28">
      <Heading as="h2" align="left">{therapy.heading}</Heading>
      <Paragraph class="text-white/80">{therapy.intro}</Paragraph>
    </div>

    <ul class="grid gap-6 grid-cols-1 md:grid-cols-2 mt-6 lg:mt-0">
      {
        therapy.items.map((item, i) => (
          <li
            class="group flex flex-col items-center text-center"
            {...(editable.therapyItems[i] ?? {})}
          >
            <div
              class="mx-auto aspect-[376/408] w-full max-w-[380px] bg-sage/20"
              style={`-webkit-mask:url(${leafMask}) center/contain no-repeat;mask:url(${leafMask}) center/contain no-repeat;`}
            >
              {item.image ? (
                <img
                  src={item.image}
                  alt={item.imageAlt}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div
                  class="flex h-full w-full items-center justify-center text-xs text-forest-deep/60"
                  aria-hidden="true"
                >
                  zdjęcie
                </div>
              )}
            </div>
            <div class="mt-4 px-2">
              <h3 class="mb-2 text-xl">{item.name}</h3>
              <p class="mx-auto max-w-prose text-sm leading-relaxed text-white/75">
                {item.description}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
