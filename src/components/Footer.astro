---
import { getContent } from '../lib/content';
import Logo from './Logo.astro';
import Container from './Container.astro';
const { footer, site, editable } = await getContent();

const year = 2026;
const logoAlt = `${site.logoLine1} ${site.logoLine2}`;
---

<footer class="bg-white text-ink" {...editable.siteSettings}>
  <Container class="flex flex-col items-center justify-between gap-4 py-8 sm:flex-row">
    <Logo
      href="#top"
      label={logoAlt}
      class="text-forest-deep [&>svg]:h-7 [&>svg]:w-auto"
    />
    <span class="text-sm text-ink-soft">{footer.text}</span>
    <span class="text-xs text-ink-soft">© {year}</span>
  </Container>
</footer>
