---
import { getContent } from '../lib/content';
const { about, editable } = await getContent();
---

<section id={about.id} class="bg-sage text-ink" {...editable.about}>
  <div
    class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-20 sm:px-8 md:grid-cols-[280px_1fr] md:gap-14 md:py-28"
  >
    <div class="mx-auto md:mx-0">
      <div
        class="h-56 w-56 overflow-hidden rounded-full bg-sage/60 sm:h-64 sm:w-64"
      >
        {
          about.image ? (
            <img
              src={about.image}
              alt={about.imageAlt}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          ) : (
            <div
              class="flex h-full w-full items-center justify-center text-sm text-ink-soft"
              aria-hidden="true"
            >
              zdjęcie
            </div>
          )
        }
      </div>
    </div>

    <div>
      <h2 class="mb-6 text-4xl sm:text-5xl">{about.heading}</h2>
      <p class="max-w-prose text-sm leading-relaxed text-ink-soft sm:text-base">
        {about.text}
      </p>
    </div>
  </div>
</section>
