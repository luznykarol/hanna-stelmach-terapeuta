---
import { getContent } from '../lib/content';
import Container from './Container.astro';
import Heading from './Heading.astro';
import RichText from './RichText.astro';
import { storyblokImage, storyblokSrcSet } from '../lib/images';

const preventWidowWords = (html: string): string => {
  const smallWords = ['i', 'a', 'o', 'z', 'w', 'u', 'na', 'do', 'ze', 'od', 'że', "I", "II"];
  let result = html;
  smallWords.forEach(word => {
    const regex = new RegExp(`\\s(${word})\\s`, 'gi');
    result = result.replace(regex, `&nbsp;$1&nbsp;`);
  });
  return result;
};

const { about, editable } = await getContent();
const processedAboutText = preventWidowWords(about.text);
---

<section id={about.id} class="bg-sage text-ink" {...editable.about}>
  <Container class="relative z-10 grid items-center gap-10 py-20  md:block lg:grid lg:grid-cols-2 lg:gap-14 lg:py-28 lg:items-start">
    <div class="mx-auto md:mx-0 about-image">
      <div
        class=" overflow-hidden rounded-full bg-white size-64 lg:size-140.25 md:float-left md:mr-6  lg:float-none"
      >
        {
          about.image ? (
            <img
              src={storyblokImage(about.image, 561, 561)}
              srcset={storyblokSrcSet(about.image, [256, 512, 561, 1122], 256)}
              sizes="(min-width: 1024px) 561px, 256px"
              alt={about.imageAlt}
              width="561"
              height="561"
              class="size-full object-cover"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div
              class="flex h-full w-full items-center justify-center text-sm text-ink-soft"
              aria-hidden="true"
            >
            </div>
          )
        }
      </div>
    </div>

    <div>
      <Heading as="h2" align="left" class="mb-6">{about.heading}</Heading>
      <RichText html={processedAboutText} class="text-ink-soft text-balance" />
    </div>
  </Container>
</section>
