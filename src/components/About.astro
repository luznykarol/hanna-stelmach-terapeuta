---
import { getContent } from '../lib/content';
import Container from './Container.astro';
import Heading from './Heading.astro';
import Paragraph from './Paragraph.astro';
const { about, editable } = await getContent();
---

<section id={about.id} class="bg-sage text-ink" {...editable.about}>
  <Container class="relative z-10 grid items-center gap-10 py-20 md:grid-cols-2 md:gap-14 md:py-28">
    <div class="mx-auto md:mx-0">
      <div
        class=" overflow-hidden rounded-full bg-white size-64 lg:size-140.25"
      >
        {
          about.image ? (
            <img
              src={about.image}
              alt={about.imageAlt}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          ) : (
            <div
              class="flex h-full w-full items-center justify-center text-sm text-ink-soft"
              aria-hidden="true"
            >
            </div>
          )
        }
      </div>
    </div>

    <div>
      <Heading as="h2" align="left" class="mb-6">{about.heading}</Heading>
      <Paragraph class="max-w-prose text-ink-soft">{about.text}</Paragraph>
    </div>
  </Container>
</section>
