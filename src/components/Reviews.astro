---
import { getContent } from '../lib/content';
import Container from './Container.astro';
import Heading from './Heading.astro';
import ParallaxFerns from './ParallaxFerns.astro';
const { reviews, editable } = await getContent();

/*
  Reviews are rendered by the official ZnanyLekarz widget.
  To activate:
    1. Log in to ZnanyLekarz → "Kanały umawiania" → "Utwórz widget".
    2. Choose the opinions ("Opinie") widget and copy the generated snippet.
    3. Paste the <script>/<div> markup into the placeholder below (Astro renders
       raw HTML fine; the widget's own <script> will execute on the client).
  Until then we show a placeholder with a link to the profile.
*/
const widgetInstalled = false;
---

<section id={reviews.id} class="relative overflow-x-clip bg-forest text-white" {...editable.reviews}>
  <ParallaxFerns variant="opinie" />
  <Container class="relative z-10 py-20 md:py-28">
    <Heading as="h2" class="mb-10 text-sage">{reviews.heading}</Heading>

    {
      widgetInstalled ? (
        <div id="zl-widget-container">
          {/* Paste ZnanyLekarz widget markup here. */}
        </div>
      ) : (
        <div
          class="flex flex-col items-center gap-4 rounded-xl border border-dashed border-cream-text/25 px-6 py-14 text-center"
        >
          <p class="max-w-md text-sm text-white/70">
            widget
            <code class="mx-1 rounded bg-forest-deep/60 px-1.5 py-0.5">
              Reviews.astro
            </code>
            .
          </p>
          <a
            href={reviews.znanylekarzProfileUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm underline underline-offset-4 hover:opacity-70"
          >
            Zobacz opinie na ZnanyLekarz →
          </a>
        </div>
      )
    }
  </Container>
</section>
