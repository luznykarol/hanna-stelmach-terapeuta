---
// One contact detail: a fern icon shown at its natural size, sitting in front of
// a white circle (the circle is the icon's background — the icon is NOT clipped
// to it and overflows top/bottom). Then a title and a value (optionally a link).
// Extra markup (e.g. a list of social links) can be passed via the default slot.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  icon: ImageMetadata;
  label: string;
  value?: string;
  /** If set, the value is rendered as a link (e.g. tel: / mailto:). */
  href?: string;
}

const { icon, label, value, href } = Astro.props;
---

<div class="flex flex-col items-center text-center max-w-[312px] w-full justify-center">
  <div class="relative flex h-40 items-center justify-center">
    <span
      class="absolute top-1/2 left-1/2 size-20 -translate-x-1/2 -translate-y-1/2 rounded-full bg-white shadow-sm"
      aria-hidden="true"
    >
    </span>
    <Image src={icon} alt="" aria-hidden="true" class="relative z-10 w-auto" />
  </div>
  <p class="mb-1 font-display text-[22px] lg:text-[30px] italic font-normal tracking-widest text-forest-deep">
    {label}
  </p>
  {
    value &&
      (href ? (
        <a href={href} class="text-sm text-forest-deep break-normal hover:underline">
          {value}
        </a>
      ) : (
        <p class="text-sm text-forest-deep break-normal">{value}</p>
      ))
  }
  <slot />
</div>
