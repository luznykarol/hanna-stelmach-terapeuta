---
// A single decorative fern, absolutely positioned within a `relative` section.
// Purely ornamental (aria-hidden, pointer-events-none), optimized to WebP, and
// drifts on scroll via the page-wide Rellax instance (see ParallaxFerns).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** Positioning/size utilities, e.g. "-left-16 bottom-8 w-[45vw] max-w-[420px]". */
  class?: string;
  /** Rellax parallax speed (negative = slower/down, positive = faster/up). */
  speed?: number | string;
}

const { src, class: className = '', speed = -2 } = Astro.props;
---

<Image
  src={src}
  alt=""
  aria-hidden="true"
  loading="lazy"
  data-rellax-speed={String(speed)}
  class={`rellax pointer-events-none absolute z-0 select-none ${className}`}
/>
