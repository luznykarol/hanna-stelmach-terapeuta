---
import { getContent } from '../lib/content';
import BookingButton from './BookingButton.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import Paragraph from './Paragraph.astro';
const { pricing, editable } = await getContent();
---

<section id={pricing.id} class="bg-sage text-forest-deep" {...editable.pricing}>
  <Container class="py-20 md:py-28">
      <div class="mx-auto w-full  grid items-center gap-10 md:grid-cols-2 md:gap-14 md:pb-28 ">

      <Heading as="h2" align="left" class="text-white">{pricing.heading}</Heading>
      <Paragraph class="text-forest-deep/80">{pricing.intro}</Paragraph>
    </div>

    <div class="grid gap-6 grid-cols-1 md:grid-cols-2">
      {
        pricing.items.map((item, i) => (
          <article
            class="flex flex-col items-center gap-5 rounded-xl bg-white px-8 py-10 text-center"
            {...(editable.pricingItems[i] ?? {})}
          >
            <h3 class="text-lg text-ink-soft">{item.name}</h3>
            <p class="font-display text-4xl text-forest-deep">
              {item.price}
              <span class="ml-1 text-sage">{item.duration}</span>
            </p>
            <BookingButton variant="dark" />
          </article>
        ))
      }
    </div>
  </Container>
</section>
