---
import { getContent } from '../lib/content';
import BookingButton from './BookingButton.astro';
import Section from './Section.astro';
import SectionIntro from './SectionIntro.astro';
const { pricing, editable } = await getContent();
---

<Section id={pricing.id} class="bg-sage text-forest-deep" fern="cennik" {...editable.pricing}>
  <SectionIntro
    heading={pricing.heading}
    html={pricing.intro}
    headingClass="text-forest-deep"
    textClass="text-forest-deep/80"
  />

    <div class="grid gap-6 grid-cols-1 md:grid-cols-2 mt-6 lg:mt-0">
      {
        pricing.items.map((item, i) => (
          <article
            class="flex flex-col items-center gap-5 rounded-xl bg-white px-8 py-10 text-center"
            {...(editable.pricingItems[i] ?? {})}
          >
            <h3 class="text-[36px] text-ink-soft">{item.name}</h3>
            <p class="font-display text-4xl text-forest-deep">
              {item.price}
              <span class="ml-1 text-sage">{item.duration}</span>
            </p>
            <BookingButton variant="dark" />
          </article>
        ))
      }
    </div>
</Section>
