---
import { getContent } from '../lib/content';
import BookingButton from './BookingButton.astro';
import Fern from './Fern.astro';
import cennikLeft from '../assets/img/cennik_left.png';
import cennikRight from '../assets/img/cennik_right.png';
const { pricing, editable } = await getContent();
---

<section
  id={pricing.id}
  class="relative overflow-hidden bg-sage text-forest-deep"
  {...editable.pricing}
>
  <Fern
    src={cennikLeft}
    speed="2"
    class="-left-16 bottom-6 w-[48vw] max-w-[420px] sm:w-[34vw]"
  />
  <Fern
    src={cennikRight}
    speed="-3"
    class="-top-4 right-4 w-[70px] sm:right-10 sm:w-[110px]"
  />
  <div class="relative z-10 mx-auto max-w-6xl px-5 py-20 sm:px-8 md:py-28">
    <div class="mb-12 grid gap-6 md:grid-cols-[1fr_1.4fr] md:items-end">
      <h2 class="text-4xl sm:text-5xl">{pricing.heading}</h2>
      <p class="text-sm leading-relaxed text-forest-deep/80 sm:text-base">
        {pricing.intro}
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:max-w-3xl lg:mx-auto">
      {
        pricing.items.map((item, i) => (
          <article
            class="flex flex-col items-center gap-5 rounded-xl bg-white px-8 py-10 text-center"
            {...(editable.pricingItems[i] ?? {})}
          >
            <h3 class="text-lg text-ink-soft">{item.name}</h3>
            <p class="font-display text-4xl text-forest-deep">
              {item.price}
              <span class="ml-1 text-sage">{item.duration}</span>
            </p>
            <BookingButton variant="dark" />
          </article>
        ))
      }
    </div>
  </div>
</section>
