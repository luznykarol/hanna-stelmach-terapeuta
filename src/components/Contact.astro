---
import { getContent } from '../lib/content';
import ContactItem from './ContactItem.astro';
import phoneIcon from '../assets/img/phone.png';
import emailIcon from '../assets/img/email.png';
import addressIcon from '../assets/img/adress.png';
import socialIcon from '../assets/img/social_media.png';
import Container from './Container.astro';
import Heading from './Heading.astro';
const { contact, editable } = await getContent();
---

<section id={contact.id} class="bg-sage text-forest-deep" {...editable.contact}>
  <Container class="py-20 md:py-28">
    <Heading as="h2" class="mb-12">{contact.heading}</Heading>

    <div class="grid grid-cols-2 md:grid-cols-4">
      <ContactItem
        icon={phoneIcon}
        label={contact.phone.label}
        value={contact.phone.value}
        href={contact.phone.href}
      />
      <ContactItem
        icon={emailIcon}
        label={contact.email.label}
        value={contact.email.value}
        href={contact.email.href}
      />
      <ContactItem
        icon={addressIcon}
        label={contact.address.label}
        value={contact.address.value}
      />
      <ContactItem icon={socialIcon} label={contact.social.label}>
        {
          contact.social.links.length > 0 ? (
            <ul class="flex justify-center gap-3">
              {contact.social.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-forest-deep hover:underline">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-forest-deep/50">—</p>
          )
        }
      </ContactItem>
    </div>

    <div class="mt-14 flex flex-col gap-7 items-center justify-center">
      <div class="overflow-hidden rounded-[31px] max-w-[654px] w-full">
        <iframe
          src={contact.mapEmbedUrl}
          title="Mapa dojazdu do gabinetu"
          class="aspect-[16/9] w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <p class="text-sm leading-relaxed text-forest-deep/80 max-w-[605px] w-full">
        <span class="font-medium">{contact.directionsTitle}</span>{' '}
        {contact.directions}
      </p>
    </div>
  </Container>
</section>
