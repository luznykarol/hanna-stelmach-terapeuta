---
import { getContent } from '../lib/content';
const { contact, editable } = await getContent();
---

<section id={contact.id} class="bg-sage text-forest-deep" {...editable.contact}>
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 md:py-28">
    <h2 class="mb-12 text-center text-4xl sm:text-5xl md:text-6xl">
      {contact.heading}
    </h2>

    <div
      class="grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4"
    >
      <div>
        <p class="mb-1 text-xs tracking-widest uppercase text-forest-deep/60">
          {contact.phone.label}
        </p>
        <a href={contact.phone.href} class="text-sm hover:underline">
          {contact.phone.value}
        </a>
      </div>
      <div>
        <p class="mb-1 text-xs tracking-widest uppercase text-forest-deep/60">
          {contact.email.label}
        </p>
        <a href={contact.email.href} class="text-sm hover:underline">
          {contact.email.value}
        </a>
      </div>
      <div>
        <p class="mb-1 text-xs tracking-widest uppercase text-forest-deep/60">
          {contact.address.label}
        </p>
        <p class="text-sm">{contact.address.value}</p>
      </div>
      <div>
        <p class="mb-1 text-xs tracking-widest uppercase text-forest-deep/60">
          {contact.social.label}
        </p>
        {
          contact.social.links.length > 0 ? (
            <ul class="flex justify-center gap-3">
              {contact.social.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm hover:underline">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-forest-deep/50">—</p>
          )
        }
      </div>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-[1fr_1.3fr] md:items-start">
      <p class="text-sm leading-relaxed text-forest-deep/80">
        <span class="font-medium">{contact.directionsTitle}</span>{' '}
        {contact.directions}
      </p>
      <div class="overflow-hidden rounded-xl">
        <iframe
          src={contact.mapEmbedUrl}
          title="Mapa dojazdu do gabinetu"
          class="aspect-[16/9] w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
