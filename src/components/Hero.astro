---
import { getContent } from '../lib/content';
import BookingButton from './BookingButton.astro';
import ParallaxFerns from './ParallaxFerns.astro';
import Container from './Container.astro';
import Heading from './Heading.astro';
import RichText from './RichText.astro';
const { hero, editable } = await getContent();
---

<section
  id="top"
  class="relative overflow-x-clip bg-forest text-white"
  {...editable.hero}
>

  <div
    class="pointer-events-none absolute inset-0 opacity-60"
    aria-hidden="true"
    style="background: radial-gradient(120% 90% at 85% 15%, rgba(154,169,134,0.35), transparent 55%), radial-gradient(80% 80% at 0% 100%, rgba(46,56,38,0.6), transparent 60%);"
  >
  </div>
  <div
    class="pointer-events-none absolute top-17.5 -right-5 lg:top-[123px] lg:right-[111px] lg:size-73 rounded-full bg-white size-40 md:right-24"
    aria-hidden="true"
  >
  </div>

  <ParallaxFerns />

  <div
    class="relative z-10 flex flex-col gap-10.5 mx-auto min-h-[90vh] justify-center items-center max-w-[560px] px-5 pt-40 pb-24 sm:px-8"
  >
    <Heading as="h1" class="text-white">{hero.title}</Heading>
    <RichText html={hero.subtitle} class="max-w-md text-center text-white" />
    <div class="flex items-center justify-center">
      <BookingButton variant="light" />
    </div>
  </div>
</section>
