---
// Body paragraph — Figma text style:
// Open Sans, 400, 22px, line-height 132%, letter-spacing -3%.
// Pass `class` to extend (e.g. color, max-width, alignment).
interface Props {
  class?: string;
}

const { class: className = '', ...rest } = Astro.props;
---

<p
  class:list={[
    'font-body text-[22px] leading-[1.32] font-normal tracking-[-0.03em]',
    className,
  ]}
  {...rest}
>
  <slot />
</p>
