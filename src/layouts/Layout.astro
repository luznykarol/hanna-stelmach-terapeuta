---
import '../styles/global.css';
import { getContent } from '../lib/content';

const { seo, business } = await getContent();

interface Props {
  title?: string;
  description?: string;
  /** Override the canonical URL (e.g. the /home editor route points at /). */
  canonicalPath?: string;
  /** Exclude from search indexing (used by the /home Visual Editor route). */
  noindex?: boolean;
  /**
   * Social-share image (Open Graph / Twitter): a CMS asset URL, or a path under
   * /public. Empty means the share tags are omitted — a tag pointing at a file
   * that does not exist renders as a broken preview, which is worse than none.
   */
  image?: string;
}

const {
  title = seo.title,
  description = seo.description,
  canonicalPath,
  noindex = false,
  image = seo.ogImage,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site).href;
// CMS assets are already absolute; a /public path is resolved against the site.
const ogImage = image ? new URL(image, Astro.site).href : '';
const siteName = business.name;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#3E553C" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        <meta
          name="robots"
          content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:alt" content={siteName} />
        </>
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- CMS images are served from Storyblok's CDN. The browser would only
         discover that host when it hits the first <img>, costing a DNS + TLS
         round trip on the critical path. -->
    <link rel="preconnect" href="https://a.storyblok.com" crossorigin />

    <!-- Self-hosted fonts (see public/fonts + @font-face in global.css).
         Preload the above-the-fold faces to avoid a flash of fallback text. -->
    <link
      rel="preload"
      href="/fonts/LTCBodoni175-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/OpenSans-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Per-page <head> extras (e.g. JSON-LD structured data). -->
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-forest-deep focus:shadow-lg"
    >
      Przejdź do treści
    </a>
    <slot />
  </body>
</html>
